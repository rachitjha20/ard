# ARD configuration. Copy to .env and change what you need. Every value is optional.

# Where ARD keeps its database and document copies.
# Default: the per-user data folder of your OS (Linux: ~/.local/share/ard).
# ARD_DATA_DIR=/path/to/ard-data

# ARD listens on this computer only. Binding elsewhere is refused unless
# ARD_ALLOW_NON_LOOPBACK=true, which exposes your documents to the network.
# ARD_HOST=127.0.0.1
# ARD_PORT=8765

# Limits applied to imported files.
# ARD_MAX_UPLOAD_MB=300
# ARD_MAX_PAGES=10000

# Background work. "process" isolates PDF parsing in worker processes.
# ARD_WORKER_MODE=process
# ARD_MAX_WORKERS=2

# ARD Guardian profile: eco | balanced | performance
# ARD_GUARDIAN_PROFILE=balanced
# ARD_GUARDIAN_ENABLED=true

# ARD_LOG_LEVEL=INFO
